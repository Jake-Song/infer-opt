            ids[:] = torch.tensor([12, 0, 7], device='cuda')
        elif routing == 'skewed':
            ids[:tokens//2] = torch.tensor([12, 0, 7], device='cuda')
        run = lambda: grouped_int8_experts(x, ids, weights, gu, gs, down, ds)
