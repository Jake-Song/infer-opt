+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3137,6 +3137,13 @@ static void ggml_cuda_graph_launch_chunk(ggml_backend_cuda_context * cuda_ctx, g
         graph->instances.emplace_back(nullptr);
         CUDA_CHECK(cudaGraphInstantiate(&graph->instances[idx], cuda_graph, nullptr, nullptr, 0));
     }
+
+    if (const char * directory = getenv("INFER_MOE_DOT_DIR")) {
+        const char * name = getenv("INFER_MOE_CASE_NAME");
+        char filename[4096];
+        snprintf(filename, sizeof(filename), "%s/%s-%zu.dot", directory, name ? name : "capture", idx);
